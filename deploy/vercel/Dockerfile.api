# EventProof API as a Vercel container service (see deploy/vercel/README.md). Same base and deps as backend/Dockerfile;
# the build context is the staging folder made by deploy/vercel/stage.sh (code + benchmark data + recorded runs).
FROM ghcr.io/astral-sh/uv:0.12.10@sha256:2bb3ebca0a796a155094a27773d290c4b074572e6107f171d88d086682fd2500 AS uv

FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337

RUN apt-get update -q \
    && apt-get install -y -q --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PYTHONUNBUFFERED=1
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/eventproof ./eventproof
RUN uv sync --frozen --no-dev
COPY benchmark /app/benchmark
COPY artifacts /app/artifacts

RUN useradd --uid 10001 --create-home eventproof && chown -R eventproof /app/artifacts
USER eventproof
ENV PATH=/app/backend/.venv/bin:$PATH EVENTPROOF_PATH_PREFIX=/api PORT=8000
CMD ["sh", "-c", "exec uvicorn eventproof.api.main:app --host 0.0.0.0 --port ${PORT}"]
