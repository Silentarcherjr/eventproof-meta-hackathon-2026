# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
.next/
out/

# Data / artifacts (large binaries live outside git; manifests + hashes are tracked)
data/
artifacts/
*.mp4
*.mov
*.webm
*.sqlite
*.db
!assets/demo/**/*.json

# OS / editors
.DS_Store
.idea/
.vscode/

# small synthetic clip (own work) used by the Playwright smoke test
!frontend/e2e/fixtures/*.mp4

# showcase server data (deploy/export_showcase.sh)
showcase-data/
showcase-data.tgz

# local research (not for the public repo)
private/

# recorded demo run shipped with the repo (synthetic clip, own work)
!demo/showcase/**/*.mp4
demo/video/voice/

!benchmark/traffic_sim/showcase/**/*.mp4
