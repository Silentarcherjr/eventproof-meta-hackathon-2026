# Copy to backend/.env (gitignored). Never commit real values.
# Meta Model API key (https://dev.meta.ai). Same key for Muse Spark and SAM 3.1.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# Budget guard (USD). Backend refuses new paid calls once the local ledger exceeds this.
META_BUDGET_USD=40
